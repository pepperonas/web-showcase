---
import '../styles/global.css';
import { site, isProduction } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Rechtliche Entwürfe u. Ä. grundsätzlich nicht indexieren */
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;

// Saubere URL ohne .html/index – unabhängig vom Build-Format
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(cleanPath, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const robots = isProduction && !noindex ? 'index, follow' : 'noindex, nofollow';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: new URL('/', Astro.site).href,
  description: site.description,
  slogan: site.claim,
  founder: { '@type': 'Person', name: site.owner },
  areaServed: { '@type': 'Country', name: 'Deutschland' },
  knowsLanguage: 'de',
};
---

<!doctype html>
<html lang="de" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical.href} />

    <link rel="preload" href="/fonts/bricolage-grotesque-latin-opsz.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-latin-wght.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={site.themeColor} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="celox – Software. Sicherheit. Automatisierung. Websites und Abläufe für kleine und mittlere Unternehmen." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <slot />
    <script>
      import '../scripts/reveal';
    </script>
    <style>
      .skip-link {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        padding: 0.75rem 1rem;
        border-radius: var(--radius-m);
        background: var(--ink);
        color: var(--paper);
        font-weight: 600;
        transform: translateY(-200%);
      }
      .skip-link:focus {
        transform: none;
      }
    </style>
  </body>
</html>

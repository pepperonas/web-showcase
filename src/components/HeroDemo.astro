---
// Interaktive Hero-Vorschau: Website-Anfrage links, strukturierter Eingang rechts.
// Funktioniert als statisches Beispiel auch ohne JavaScript (Radio-Buttons + vorbefüllte Karte).
const topics = [
  { value: 'bad', label: 'Badsanierung' },
  { value: 'heizung', label: 'Heizung tauschen' },
  { value: 'reparatur', label: 'Reparatur' },
];
const timings = [
  { value: 'bald', label: 'So bald wie möglich' },
  { value: 'monate', label: 'In 1–3 Monaten' },
  { value: 'kosten', label: 'Erst Kosten einschätzen' },
];
---

<figure class="hero-demo registered" data-hero-demo aria-labelledby="hero-demo-caption">
  <figcaption id="hero-demo-caption" class="hero-demo__caption">
    <span class="demo-badge">Beispieldemo</span>
    <span>Fiktiver Betrieb · es wird nichts gesendet</span>
  </figcaption>

  <div class="hero-demo__grid">
    <div class="hero-demo__site">
      <div class="hero-demo__bar" aria-hidden="true">
        <span class="hero-demo__dots"><i></i><i></i><i></i></span>
        <span class="hero-demo__url">wendt-haustechnik.example</span>
      </div>
      <div class="hero-demo__site-body">
        <p class="hero-demo__brand" aria-hidden="true">Wendt <b>Haustechnik</b></p>
        <form class="hero-demo__form" data-hero-form onsubmit="return false">
          <fieldset>
            <legend>Worum geht es?</legend>
            <div class="pills">
              {topics.map((t, i) => (
                <label class="pill">
                  <input type="radio" name="topic" value={t.value} checked={i === 0} />
                  <span>{t.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <fieldset>
            <legend>Wann soll es losgehen?</legend>
            <div class="pills">
              {timings.map((t, i) => (
                <label class="pill">
                  <input type="radio" name="timing" value={t.value} checked={i === 1} />
                  <span>{t.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <label class="hero-demo__photos">
            <input type="checkbox" name="photos" checked />
            <span class="hero-demo__photo-thumbs" aria-hidden="true"><i></i><i></i></span>
            <span>2 Fotos vom Ist-Zustand anhängen</span>
          </label>
        </form>
      </div>
    </div>

    <div class="hero-demo__wire" aria-hidden="true"><span></span></div>

    <div class="hero-demo__inbox" aria-live="polite">
      <p class="hero-demo__inbox-title">So kommt die Anfrage bei Ihnen an</p>
      <p class="hero-demo__instead">
        statt <q>Was kostet bei Ihnen ein neues Bad?</q>
      </p>
      <dl class="ticket" data-ticket>
        <div><dt>Anliegen</dt><dd data-out="topic">Badsanierung</dd></div>
        <div><dt>Zeitraum</dt><dd data-out="timing">In 1–3 Monaten</dd></div>
        <div><dt>Unterlagen</dt><dd data-out="photos">2 Fotos</dd></div>
        <div><dt>Zuständig</dt><dd data-out="team">Team Bad &amp; Sanitär</dd></div>
        <div class="ticket__next"><dt>Nächster Schritt</dt><dd data-out="next">Aufmaß-Termin vorschlagen</dd></div>
      </dl>
      <p class="ticket__status" data-status>
        <svg class="ok" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
        <svg class="warn" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v7M8 11.8v1.8" fill="none" stroke="currentColor" stroke-width="2.2"></path></svg>
        <span data-status-text>Vollständig – ohne Rückfrage bearbeitbar</span>
      </p>
    </div>
  </div>
</figure>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero-demo]');
  const form = root?.querySelector<HTMLFormElement>('[data-hero-form]');

  const topicMap: Record<string, { label: string; team: string; next: string }> = {
    bad: { label: 'Badsanierung', team: 'Team Bad & Sanitär', next: 'Aufmaß-Termin vorschlagen' },
    heizung: { label: 'Heizung tauschen', team: 'Team Heizung', next: 'Vor-Ort-Termin vorschlagen' },
    reparatur: { label: 'Reparatur', team: 'Kundendienst', next: 'Rückruf einplanen' },
  };
  const timingMap: Record<string, string> = {
    bald: 'So bald wie möglich · dringend',
    monate: 'In 1–3 Monaten',
    kosten: 'Richtpreis gewünscht',
  };

  if (root && form) {
    const out = (key: string) => root.querySelector<HTMLElement>(`[data-out="${key}"]`);
    const ticket = root.querySelector<HTMLElement>('[data-ticket]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const statusText = root.querySelector<HTMLElement>('[data-status-text]');
    const photoQuestion = 'Fotos nachfordern';

    const update = () => {
      const data = new FormData(form);
      const topic = topicMap[String(data.get('topic'))] ?? topicMap.bad;
      const timing = String(data.get('timing'));
      const photos = data.get('photos') === 'on';

      out('topic')!.textContent = topic.label;
      out('timing')!.textContent = timingMap[timing] ?? '';
      out('photos')!.textContent = photos ? '2 Fotos' : 'keine';
      out('team')!.textContent = topic.team;
      out('next')!.textContent = timing === 'kosten' ? 'Richtpreis-Spanne senden' : photos ? topic.next : photoQuestion;

      const complete = photos;
      status?.classList.toggle('is-incomplete', !complete);
      if (statusText)
        statusText.textContent = complete
          ? 'Vollständig – ohne Rückfrage bearbeitbar'
          : 'Eine Rückfrage nötig: Fotos fehlen';

      root.classList.remove('is-pulsing');
      ticket?.classList.remove('is-updated');
      void root.offsetWidth; // Animation neu starten
      root.classList.add('is-pulsing');
      ticket?.classList.add('is-updated');
    };

    form.addEventListener('change', update);
  }
</script>

<style>
  .hero-demo {
    margin: 0;
    padding: var(--space-4);
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
  }

  .hero-demo__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-bottom: var(--space-4);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .hero-demo__caption .demo-badge {
    color: var(--signal-ink);
  }

  .hero-demo__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 40em) {
    .hero-demo__grid {
      grid-template-columns: minmax(0, 1.08fr) 2.25rem minmax(0, 1fr);
      align-items: center;
    }
  }

  /* Website-Seite */
  .hero-demo__site {
    background: #fff;
    border-radius: var(--radius-m);
    box-shadow: 0 1px 0 rgb(21 23 28 / 0.06), 0 18px 40px -22px rgb(21 23 28 / 0.35);
    overflow: hidden;
  }

  .hero-demo__bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    background: #f1efe9;
    border-bottom: 1px solid #e4e0d6;
    font-size: 0.6875rem;
    color: #5d616a;
  }

  .hero-demo__dots {
    display: flex;
    gap: 4px;
  }

  .hero-demo__dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d4cfc3;
  }

  .hero-demo__url {
    flex: 1;
    padding: 0.15rem 0.5rem;
    background: #fff;
    border-radius: 3px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-demo__site-body {
    padding: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .hero-demo__brand {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 500;
    color: #1d4b63;
    letter-spacing: -0.01em;
  }

  .hero-demo__brand b {
    font-weight: 750;
  }

  .hero-demo__form {
    display: grid;
    gap: var(--space-4);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    margin-bottom: 0.5rem;
    font-weight: 650;
    font-size: 0.9375rem;
    color: #15171c;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pill {
    position: relative;
    cursor: pointer;
  }

  .pill input,
  .hero-demo__photos input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .pill span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid #c9d4da;
    border-radius: 999px;
    background: #fff;
    color: #1d3a4a;
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      background-color var(--dur-fast) linear,
      border-color var(--dur-fast) linear,
      color var(--dur-fast) linear;
  }

  .pill:hover span {
    border-color: #1d4b63;
  }

  .pill input:checked + span {
    background: #1d4b63;
    border-color: #1d4b63;
    color: #fff;
  }

  .pill input:checked + span::before {
    content: '';
    width: 0.55rem;
    height: 0.3rem;
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-1px) rotate(-45deg);
  }

  .pill input:focus-visible + span,
  .hero-demo__photos input:focus-visible ~ span:last-child {
    outline: 3px solid var(--signal-ink);
    outline-offset: 2px;
  }

  .hero-demo__photos {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.6rem;
    border: 1px dashed #b6c3ca;
    border-radius: var(--radius-m);
    font-size: 0.875rem;
    color: #1d3a4a;
    cursor: pointer;
  }

  .hero-demo__photo-thumbs {
    display: flex;
  }

  .hero-demo__photo-thumbs i {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 4px;
    border: 2px solid #fff;
    background: linear-gradient(135deg, #a9c3cf, #6d8f9f);
    transition: opacity var(--dur-fast) linear;
  }

  .hero-demo__photo-thumbs i + i {
    margin-left: -0.5rem;
    background: linear-gradient(135deg, #d9c9b0, #a88d69);
  }

  .hero-demo__photos input:not(:checked) ~ .hero-demo__photo-thumbs i {
    opacity: 0.25;
  }

  .hero-demo__photos input:not(:checked) ~ span:last-child {
    text-decoration: line-through;
    color: #5d616a;
  }

  /* Verbindung */
  .hero-demo__wire {
    position: relative;
    height: 2rem;
    display: grid;
    place-items: center;
  }

  .hero-demo__wire::before {
    content: '';
    width: 1px;
    height: 100%;
    background-image: linear-gradient(var(--line-strong) 50%, transparent 50%);
    background-size: 1px 6px;
  }

  .hero-demo__wire span {
    position: absolute;
    width: 9px;
    height: 9px;
    background: var(--signal);
    top: 0;
    left: calc(50% - 4.5px);
    opacity: 0;
  }

  @media (min-width: 40em) {
    .hero-demo__wire {
      height: auto;
      align-self: stretch;
    }
    .hero-demo__wire::before {
      width: 100%;
      height: 1px;
      background-image: linear-gradient(90deg, var(--line-strong) 50%, transparent 50%);
      background-size: 6px 1px;
    }
    .hero-demo__wire span {
      top: calc(50% - 4.5px);
      left: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-demo.is-pulsing .hero-demo__wire span {
      animation: wire-v 700ms var(--ease-in-out);
    }
    @media (min-width: 40em) {
      .hero-demo.is-pulsing .hero-demo__wire span {
        animation-name: wire-h;
      }
    }
    .ticket.is-updated dd {
      animation: ticket-in 520ms var(--ease-out) 380ms backwards;
    }
  }

  @keyframes wire-v {
    0% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(1.5rem); }
  }
  @keyframes wire-h {
    0% { opacity: 1; transform: translateX(0); }
    100% { opacity: 0; transform: translateX(1.75rem); }
  }
  @keyframes ticket-in {
    from { opacity: 0.2; transform: translateX(-4px); }
  }

  /* Eingang */
  .hero-demo__inbox {
    padding: var(--space-4);
    background: var(--ink);
    color: var(--on-dark);
    border-radius: var(--radius-m);
    display: grid;
    gap: var(--space-3);
  }

  .hero-demo__inbox-title {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .hero-demo__instead {
    font-size: 0.8125rem;
    color: var(--on-dark-muted);
  }

  .hero-demo__instead q {
    text-decoration: line-through;
    text-decoration-color: var(--signal-on-dark);
  }

  .ticket {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--on-dark-line);
  }

  .ticket div {
    display: grid;
    grid-template-columns: 7.25rem 1fr;
    gap: 0.1rem 0.5rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--on-dark-line);
    font-size: 0.875rem;
  }

  .ticket dt {
    color: var(--on-dark-muted);
  }

  .ticket dd {
    margin: 0;
    font-weight: 600;
  }

  /* Schmale Spalte neben dem Formular: Beschriftung über dem Wert */
  @media (min-width: 40em) {
    .ticket div {
      grid-template-columns: 1fr;
    }
    .ticket dt {
      font-size: 0.75rem;
    }
  }

  .ticket__next dd {
    color: var(--signal-on-dark);
  }

  .ticket__status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #8fd9b3;
  }

  .ticket__status svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .ticket__status.is-incomplete {
    color: #ffc27a;
  }

  .ticket__status .warn,
  .ticket__status.is-incomplete .ok {
    display: none;
  }

  .ticket__status.is-incomplete .warn {
    display: block;
  }
</style>
